<?xml version="1.0"?>
<Project Name="chronicle" StartupScreen="chronicle/App" WindowWidth="400" WindowHeight="800"> 
  <Project.ProjectReferences>
    <ProjectReference Name="applications" Path="applications" />
    <ProjectReference Name="assets" Path="assets" />
    <ProjectReference Name="model" Path="model" />
    <ProjectReference Name="root" Path="root" />
    <ProjectReference Name="config" Path="config" />
    <!-- External libraries -->
    <ProjectReference Name="appwrite" Path="lib/appwrite" />
    <ProjectReference Name="html" Path="lib/html" />
    <ProjectReference Name="routing" Path="lib/routing" />
    <ProjectReference Name="openai" Path="lib/openai" />
    <ProjectReference Name="tailwind" Path="lib/tailwind" />
    <ProjectReference Name="zilscript" Path="lib/zilscript/zilscript" />
    <ProjectReference Name="zork1" Path="lib/zilscript/zork1" />
    <ProjectReference Name="adventure" Path="lib/zilscript/adventure" />
  </Project.ProjectReferences>
  <Project.SystemMessages>
    <SystemMessage Message="KeyDown" Key="q" Command="return"/>
    <SystemMessage Message="WindowClosed" Command="return"/>
    <SystemMessage Message="RequestReload" Command="window:refresh()"/>
  </Project.SystemMessages>
  <FontLibrary Name="fonts" />
</Project>
